<% if (locals.ERRORS) {%>
  <ul class="error-list">
    <% ERRORS.forEach(function(error) { %>
      <li><%= error.msg %></li>
    <% }); %>
  </ul>
<% } %>
<% if(locals.loginErrors && loginErrors.length > 0) { %>
  <ul class="error-list">
    <% loginErrors.forEach(function(err) { %>
      <li><%= err %></li>
    <% }); %>
  </ul>
<% } %>