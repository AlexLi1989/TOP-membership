<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main>

      <div class="hero">
        <h1>Welcome to Alex's Private Club</h1>
        <p>Feel free to join our club!</p>
      </div>

      <% if(currentUser && (!currentUser.admin_status || !currentUser.member_status)) {%>
        <div class="upgrade-prompt">
          <a href="/auth/upgrade">Upgrade your status</a>
        </div>
      <% } %>
      <div class="index-grid-container">
        <div class="message-cards-container">
        <% for (let message of MESSAGES) { %>
          <div class="message-card">
              <div class="message-details">
                <p>Message by: <%= (currentUser && (currentUser.member_status || currentUser.admin_status)) ? message.full_name : "Anonymous" %></p>
                <p>Date: <%= (currentUser && (currentUser.member_status || currentUser.admin_status)) ? message.date.toLocaleDateString() : "••••-••-••" %></p>
              </div>
            <p class="message"><%= message.message %> </p>
          </div>
          <% if(currentUser && currentUser.admin_status) {%>
            <div class="delete-form-container">
              <form action="/messages/<%= message.message_id %>" method="POST">
                <input type="hidden" name="message_id" value="<%= message.message_id %>">
                <button type="submit">Delete</button>
              </form>
            </div>
          <% } %>
        <% } %>
        </div>

        <% if(currentUser) {%>
        <div class="message-form-container">
        <div class="message-form">
          <form action="/messages" method="POST">
            <label for="message">Leave a message: </label>
            <textarea class="form-input" id="message" name="message" rows="4" cols="50" placeholder="Please enter your message here..." required><%- locals.LASTPARAMS?.message || "" %></textarea>
            <button type="submit">Send</button>
          </form>
        <%- include("partials/errors") %>
        </div>
      </div>
      <% } %>
      </div>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>